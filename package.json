{
  "name": "juicy",
  "version": "0.3.1",
  "private": true,
  "description": "A pink, playful theme for Stash, installable as a plugin",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "prettier --check . && eslint && stylelint \"**/*.css\"",
    "format": "prettier --write . && eslint --fix && stylelint --fix \"**/*.css\"",
    "deploy:local": "pnpm build && scripts/deploy-local.sh",
    "test:compat": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "bootstrap": "4.6.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
