{
  "name": "candyboudoir",
  "private": true,
  "description": "CandyBoudoir's plugins for Stash, published as one plugin source",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "prettier --check . && eslint && stylelint \"**/*.css\"",
    "format": "prettier --write . && eslint --fix && stylelint --fix \"**/*.css\"",
    "deploy:local": "pnpm build && scripts/deploy-local.sh",
    "smoke": "node plugins/cherrypick/tests/smoke.mjs",
    "test:compat": "playwright test",
    "test:unit": "node --test \"plugins/*/tests/unit/*.unit.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/mr-dafoe": "5.3.0",
    "@playwright/test": "^1.64.0",
    "bootstrap": "4.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "idb-keyval": "^6.3.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
